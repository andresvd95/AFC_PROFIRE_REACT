# AFC Pro Fire — SPA React (Vite + React Router).
# Este archivo se copia a dist/ en cada build. Servidor: Apache / LiteSpeed.

Options -MultiViews
DirectoryIndex index.html

# ---- Enrutado del cliente: cualquier ruta que no sea un archivo real -> index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # deja pasar archivos y carpetas que existen (assets, .htaccess, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # el resto lo resuelve React Router
  RewriteRule ^ index.html [L]
</IfModule>

# ---- MIME types
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/json .json .map
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
  AddType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet .xlsx
</IfModule>

# ---- Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- Caché
<IfModule mod_expires.c>
  ExpiresActive On
  # index.html siempre fresco (para no servir un bundle viejo tras un deploy)
  ExpiresByType text/html "access plus 0 seconds"
  # los assets llevan hash en el nombre -> caché larga
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|jpe?g|png|webp|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
